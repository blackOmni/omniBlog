{
  "info": {
    "name": "postBlog API",
    "description": "API collection for refactored postBlog Express server",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          }
        },
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/signup",
              "host": ["{{baseUrl}}"],
              "path": ["users", "signup"]
            }
          }
        },
        {
          "name": "Log In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Blogs",
      "item": [
        {
          "name": "Get All Blogs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blogs",
              "host": ["{{baseUrl}}"],
              "path": ["blogs"]
            }
          }
        },
        {
          "name": "Add Blog",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Blog\",\n  \"desc\": \"This is the content of my first blog post.\",\n  \"img\": \"https://via.placeholder.com/150\",\n  \"user\": \"USER_ID_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/add",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "add"]
            }
          }
        },
        {
          "name": "Get Blog By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blogs/BLOG_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "BLOG_ID_HERE"]
            }
          }
        },
        {
          "name": "Update Blog",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Blog Title\",\n  \"desc\": \"Updated blog content body.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/blogs/update/BLOG_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "update", "BLOG_ID_HERE"]
            }
          }
        },
        {
          "name": "Delete Blog",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blogs/BLOG_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "BLOG_ID_HERE"]
            }
          }
        },
        {
          "name": "Get Blogs By User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/blogs/user/USER_ID_HERE",
              "host": ["{{baseUrl}}"],
              "path": ["blogs", "user", "USER_ID_HERE"]
            }
          }
        }
      ]
    }
  ]
}